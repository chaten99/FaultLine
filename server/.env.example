NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CLIENT_ORIGINS=http://localhost:5173
APP_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/faultline
JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_at_least_32_characters
CSRF_SECRET=replace_with_another_random_secret_at_least_32_characters
JWT_ISSUER=faultline-api
JWT_ACCESS_AUDIENCE=faultline-client
JWT_REFRESH_AUDIENCE=faultline-refresh
JWT_ACCESS_TTL_SECONDS=600
JWT_REFRESH_IDLE_TTL_DAYS=7
JWT_REFRESH_ABSOLUTE_TTL_DAYS=30
