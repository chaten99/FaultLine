<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 24px;border:1px solid #e5e5e5;">
<% rows.forEach(function (row, index) { %>
  <tr>
    <td style="padding:10px 14px;width:38%;background:#fafafa;color:#737373;font-size:13px;vertical-align:top;<%= index > 0 ? 'border-top:1px solid #e5e5e5;' : '' %>"><%= row[0] %></td>
    <td style="padding:10px 14px;color:#171717;font-size:14px;word-break:break-word;<%= index > 0 ? 'border-top:1px solid #e5e5e5;' : '' %>"><%= row[1] %></td>
  </tr>
<% }); %>
</table>
