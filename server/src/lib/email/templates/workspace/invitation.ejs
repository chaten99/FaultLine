<%
const messageBlock = personalMessage
  ? `<div style="margin:0 0 24px;padding:14px 16px;border-left:3px solid #171717;background:#fafafa;color:#404040;font-size:14px;"><strong style="display:block;margin-bottom:4px;font-size:12px;color:#737373;">Message from ${e(inviterName)}</strong>${e(personalMessage)}</div>`
  : "";
const body = `
  <h1 style="margin:0 0 16px;font-size:26px;line-height:1.25;">You've been invited to join ${e(workspaceName)}</h1>
  <p style="margin:0 0 20px;color:#525252;"><strong>${e(inviterName)}</strong> invited you to collaborate in the <strong>${e(workspaceName)}</strong> workspace on FaultLine as <strong>${e(roleLabel)}</strong>.</p>
  <p style="margin:0 0 24px;color:#525252;">${e(roleDescription)}</p>
  ${messageBlock}
  <p style="margin:0 0 24px;"><a href="${e(acceptUrl)}" style="display:inline-block;padding:12px 22px;background:#171717;color:#ffffff;text-decoration:none;font-size:14px;font-weight:700;">Accept invitation</a></p>
  <p style="margin:0 0 8px;color:#525252;">This invitation expires in ${e(expiryDays)} days and can be used once.</p>
  <p style="margin:16px 0 0;color:#737373;font-size:13px;">Sign in or create an account with this email address (${e(email)}) to accept. If you weren't expecting this invitation, you can ignore this email. Never forward it: the link works only for this address.</p>
`;
%>
<%- include("../layouts/email-layout.ejs", { subject, body, footer }) %>
