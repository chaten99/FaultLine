<%
const body = `
  <h1 style="margin:0 0 16px;font-size:28px;line-height:1.2;">Reset your password</h1>
  <p style="margin:0 0 20px;">Hi ${name},</p>
  <p style="margin:0 0 24px;color:#525252;">We received a request to reset the password associated with your FaultLine account. Enter the code below to verify your request.</p>
  <div style="margin:0 0 24px;padding:20px;text-align:center;background:#171717;color:#ffffff;font-size:32px;font-weight:700;letter-spacing:10px;">${code}</div>
  <p style="margin:0 0 8px;color:#525252;">This code expires in ${expiryMinutes} minutes.</p>
  <p style="margin:24px 0 0;color:#737373;font-size:13px;">If you did not request a password reset, ignore this email. Your password will not change unless the reset process is successfully completed.</p>
`;
%>
<%- include("../layouts/email-layout.ejs", { subject: "Reset your FaultLine password", body }) %>
