NODE_ENV=production
PORT=4000
LOG_LEVEL=info
MONGODB_URI=mongodb://mongodb:27017/faultline
REDIS_URL=redis://redis:6379
WORKER_CONCURRENCY=10
CHECK_RETENTION_DAYS=30
MONITOR_QUEUE_NAME=faultline-monitor-checks
NOTIFICATION_QUEUE_NAME=faultline-notifications
NOTIFICATION_WORKER_CONCURRENCY=5
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_DELIVERY_TIMEOUT_MS=10000
NOTIFICATION_OUTBOX_INTERVAL_MS=30000
